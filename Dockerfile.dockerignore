# Used instead of .dockerignore when building the editor image (BuildKit reads
# a `<Dockerfile>.dockerignore` first). It adds what the editor build never
# reads: the server, the audit, the CI files and the database image.
server/
Audit/
.github/
.husky/
db/

# Ignore node_modules and build directories, at any depth (including server/)
**/node_modules
**/dist
**/build

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore local environment files at any depth (server/.env holds secrets)
**/.env
**/.env.*

# Ignore Dockerfile and Docker Compose files
Dockerfile
docker-compose.yml

# Ignore git files
.git
.gitignore

# Ignore IDE and editor settings
.vscode/
.idea/

# Ignore tests and documentation
**/__tests__/
**/test/
**/tests/
**/spec/
*.md

# Ignore temporary files
*.swp
*.swo
*.DS_Store
*.log
*.lock
*.tmp

# Ignore coverage output
coverage

# Database dumps made by the upgrade guide: they hold roles and password hashes
qbase-backup*.sql
qbase-*.dump
