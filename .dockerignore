# Dependencies and build output, at any depth (server/ has its own)
**/node_modules
**/dist
**/build
coverage

# Environment files at any depth: server/.env holds secrets
**/.env
**/.env.*

# Not read by the image: audit notes, CI, git hooks, version control
Audit/
.github/
.husky/
.git
.gitignore

# The image build does not need the build files themselves
Dockerfile
docker-compose.yml

# Editors
.vscode/
.idea/

# Tests and documents
**/__tests__/
**/test/
**/tests/
**/spec/
*.md

# Scratch files
*.log
*.lock
*.tmp
*.swp
*.swo
*.DS_Store

# Dumps written by the upgrade guide: they contain roles and password hashes
qbase-backup*.sql
qbase-*.dump
