# Dependencies and build output, at any depth (server/ has its own)
**/node_modules
**/dist
**/build
coverage

# Environment files at any depth: server/.env holds secrets
**/.env
**/.env.*

# Not read by the image: audit notes, rewrite records, dev tools, load tests, CI,
# git hooks, version control
audit/
design/
rewrite/
tools/
server/load/
.github/
.husky/
.claude/
.git
.gitignore

# The image build does not need the build files themselves
Dockerfile
docker-compose.yml

# Editors
.vscode/
.idea/

# Tests and documents
**/__tests__/
**/test/
**/tests/
**/*.test.ts
**/*.test.tsx
**/spec/
*.md

# Scratch files
*.log
*.lock
*.tmp
*.swp
*.swo
*.DS_Store

# Dumps written by the upgrade guide: they contain roles and password hashes
qbase-backup*.sql
qbase-*.dump
