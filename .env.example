# Copy to .env and adjust. Read by `docker compose` and by Vite (VITE_* only).
# Every value has a development default, so nothing here is required locally.
# Change the secrets and passwords before exposing the stack anywhere.

# --- QubdiDB's own (core) database ---
POSTGRES_USER=qubdidb
POSTGRES_PASSWORD=qubdidb
POSTGRES_DB=qubdidb
# Host port the core database is published on
POSTGRES_PORT=5433

# --- Backend ---
SESSION_SECRET=change-me
# Encrypts saved database passwords (at least 16 characters)
CONNECTION_KEY=
# Hosts the server may introspect even though they are private, comma separated
INTROSPECT_ALLOW_HOSTS=
SERVER_PORT=3001
# Origin the editor is served from
CORS_ORIGIN=http://localhost:8080

# --- Editor (UI) ---
UI_PORT=8080
# Backend the editor talks to, as seen from the browser. Unset = local-only mode
VITE_QUBDI_BACKEND_URL=http://localhost:3001
# Public URL of the editor, used for canonical and social-share links.
# Unset = no canonical links
VITE_HOST_URL=

# --- Optional SQL Server container for introspection tests ---
MSSQL_SA_PASSWORD=Qubdi_Strong_Pass1
