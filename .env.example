# =============================================================================
# QBase - environment file
# =============================================================================
# Copy this file to ".env" next to the docker-compose file and adjust it:
#
#   cp .env.example .env
#
# `docker compose` reads .env automatically. Never commit .env or share it: it
# holds passwords and encryption keys.
#
# You must set two values; Compose refuses to start without them:
#   POSTGRES_PASSWORD   the password of QBase's own database
#   CONNECTION_KEY      the key that encrypts saved database passwords
# Generate a good value for either with:   openssl rand -hex 24
#
# Everything else has a default that suits running on one machine. Services
# listen on this machine only (127.0.0.1) until you set a *_BIND_IP to 0.0.0.0.
# A line left empty (NAME=) is the same as not set.

# --- Which version to run ----------------------------------------------------
# The tag of the published image, qubdi/qbase (the editor and its API in one).
# docker-compose.yml names the release it belongs to; set a tag here to run another
# one, so an update happens when you decide. To update, change the tag, then run
# `docker compose pull` and `docker compose up -d`. Unset = that release, not "latest".
# QBASE_VERSION=1.2.0

# Bind addresses used below: 127.0.0.1 = reachable from this machine only (the
# default); 0.0.0.0 = reachable from other machines too.

# --- QBase's own (core) database ----------------------------------------------
# Stores QBase's data: users, projects, diagrams, snapshots, share links.
# This is not the database you draw diagrams of.
#
# Account and database created on the first start. Changing them later does not
# rename anything inside an existing database volume.
POSTGRES_USER=qbase
# REQUIRED. Choose your own, e.g. `openssl rand -hex 24`. Use letters and digits
# (or hex) to avoid characters that need escaping in a connection URL.
POSTGRES_PASSWORD=
POSTGRES_DB=qbase
# Where the server finds the core database. "db" is the bundled container.
# To use a PostgreSQL on another machine, set its address (and port) here and
# start only the app with `docker compose up -d --no-deps app` (README, Option B);
# the compose file does not need editing.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Address and port on THIS machine where the bundled database is published (for
# backups and tools). The server does not use this port: it reaches the database
# over Docker's own network.
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PUBLISH_PORT=5433

# --- Backend (server) --------------------------------------------------------
# REQUIRED. Encrypts the database passwords people save for drift checks and
# re-syncs (at least 32 characters), e.g. `openssl rand -hex 24`. The server
# refuses a shorter key at start; ALLOW_SHORT_KEYS=1 (below) keeps an older,
# shorter one (16 or more) working.
# Keep it safe: if it is lost, saved connections become unreadable and have to be
# entered again.
CONNECTION_KEY=
# Optional. Encrypts the secrets of authenticator apps (two-factor sign-in), at
# least 32 characters. Unset = CONNECTION_KEY is used; with neither, two-factor
# sign-in is simply not offered. Keep it: without it, people who turned
# two-factor on cannot sign in.
SECRETS_KEY=
# Set to 1 only to keep running on an existing CONNECTION_KEY or SECRETS_KEY of
# 16 to 31 characters. Such a key is warned about at start; replace it when you can.
ALLOW_SHORT_KEYS=
# false removes two-factor sign-in completely (no endpoints, no screens).
MFA_ENABLED=true
# 30-second steps a code is accepted either side of now (0 to 5). The server's
# clock must be right (NTP): a code is only good for about 30 seconds.
MFA_WINDOW_STEPS=1
# Hosts the server may connect to even though they are private (it blocks
# private addresses by default so it cannot be used to probe your network).
# Comma separated hostnames, IPs or IPv4 CIDRs, e.g. db.internal,10.0.0.0/8
INTROSPECT_ALLOW_HOSTS=
# The same, for drift webhooks only (private webhook targets are blocked by default).
WEBHOOK_ALLOW_HOSTS=
# The server's other settings (rate limits, retention, body limits, log level,
# TRUST_PROXY, cookie and session options, ...) are passed through when you add
# them here. Each is described, with its default, in server/.env.example.

# --- Where QBase listens -----------------------------------------------------
# Address and port on THIS machine where QBase (the editor and its API) is
# published. Behind a reverse proxy, keep 127.0.0.1 and let the proxy reach it.
APP_BIND_IP=127.0.0.1
APP_PORT=8080

# --- Development only: building and running the editor from source ----------
# Where `npm run dev` finds the backend (Vite reads VITE_* names). The image needs
# no such setting: its server hands the editor its own address.
VITE_QUBDI_BACKEND_URL=http://localhost:3001

# --- Development only: optional SQL Server for the introspection tests -------
# No default. Used only by docker-compose.mssql.yml, to run the SQL Server tests.
# SQL Server wants at least 8 characters from three of: upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=
MSSQL_BIND_IP=127.0.0.1
MSSQL_PORT=14333
