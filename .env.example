# Copy to .env and adjust. Read by `docker compose` and by Vite (VITE_* only).
# POSTGRES_PASSWORD has no default: `docker compose` refuses to start without it.
# Everything else has a development default. Services listen on this machine
# only (127.0.0.1) until you set a *_BIND_IP to 0.0.0.0 to expose them.

# Bind addresses: 127.0.0.1 = this machine only (the default), 0.0.0.0 = reachable from other machines.

# --- QubdiDB's own (core) database ---
POSTGRES_USER=qubdidb
# required; choose your own, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_DB=qubdidb
# Where the server finds the core database. `db` is the bundled container;
# set an IP or hostname (and POSTGRES_PORT) to use Postgres on another machine,
# then start without the bundled one: docker compose up -d --no-deps server ui
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Address and port the bundled container is published on
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PUBLISH_PORT=5433

# --- Backend ---
# Required. Encrypts saved database passwords (at least 16 characters); choose your
# own, e.g. `openssl rand -hex 24`
CONNECTION_KEY=
# Encrypts the secrets of authenticator apps (two-factor sign-in), at least 16
# characters. Unset = CONNECTION_KEY is used; with neither, two-factor sign-in is
# simply not offered. Keep it: without it people who turned two-factor on cannot sign in
SECRETS_KEY=
# false removes two-factor sign-in completely (no endpoints, no screens)
MFA_ENABLED=true
# 30-second steps a code is accepted either side of now (0 to 5). The server's
# clock must be right (NTP): a code is only good for about 30 seconds
MFA_WINDOW_STEPS=1
# Hosts the server may introspect even though they are private, comma separated
INTROSPECT_ALLOW_HOSTS=
# The server's other settings (rate limits, retention, body limits, log level,
# TRUST_PROXY, ...) are passed through when set here; each is described in
# server/.env.example and falls back to the server's own default when unset.
# Address and port the backend is published on
SERVER_BIND_IP=127.0.0.1
SERVER_PORT=3001
# Origin the editor is served from (use the editor's real address when not local)
CORS_ORIGIN=http://localhost:8080

# --- Editor (UI) ---
# Address and port the editor is published on
UI_BIND_IP=127.0.0.1
UI_PORT=8080
# Backend the editor talks to, as seen from the browser: use the machine's
# address, not localhost, when others connect. Unset = local-only mode.
# Docker serves it at run time, so changing it needs no rebuild.
QUBDI_BACKEND_URL=http://localhost:3001
# The same setting for `npm run dev` (Vite reads VITE_* names)
VITE_QUBDI_BACKEND_URL=http://localhost:3001
# Public URL of the editor, used for canonical and social-share links.
# Unset = no canonical links
VITE_HOST_URL=
# Where "use this template" sends the visitor when the editor lives on another
# origin than the template pages. Unset = stay on the same site
VITE_APP_URL=

# --- Optional SQL Server container for introspection tests ---
MSSQL_SA_PASSWORD=Qubdi_Strong_Pass1
MSSQL_BIND_IP=127.0.0.1
MSSQL_PORT=14333
