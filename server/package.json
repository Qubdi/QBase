{
    "name": "qubdidb-server",
    "license": "AGPL-3.0-only",
    "version": "1.20.1",
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "prestart": "npm run build",
        "start": "node dist/server/src/server.js",
        "lint:diagram": "tsx src/cli/lint.ts",
        "mfa:reset": "tsx src/cli/mfa-reset.ts",
        "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "db:generate": "drizzle-kit generate",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.2",
        "@fastify/rate-limit": "^11.2.1",
        "@node-rs/argon2": "^2.0.2",
        "drizzle-orm": "^0.45.4",
        "fastify": "^5.4.0",
        "mssql": "^12.7.9",
        "pg": "^8.16.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/mssql": "^12.3.0",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.15.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "drizzle-kit": "^0.31.0",
        "eslint": "^10.13.0",
        "tsx": "^4.20.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.5"
    },
    "overrides": {
        "@esbuild-kit/core-utils": {
            "esbuild": "^0.25.12"
        }
    }
}
