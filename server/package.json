{
    "name": "qubdidb-server",
    "version": "1.20.1",
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "prestart": "npm run build",
        "start": "node dist/server/src/server.js",
        "lint:diagram": "tsx src/cli/lint.ts",
        "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "db:generate": "drizzle-kit generate",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.2",
        "@fastify/rate-limit": "^10.3.0",
        "@node-rs/argon2": "^2.0.2",
        "drizzle-orm": "^0.45.4",
        "fastify": "^5.4.0",
        "mssql": "^12.7.4",
        "pg": "^8.16.0",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/mssql": "^12.3.0",
        "@types/node": "^22.15.0",
        "@types/pg": "^8.15.0",
        "drizzle-kit": "^0.31.0",
        "eslint": "^10.12.0",
        "tsx": "^4.20.0",
        "typescript": "^5.8.0",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.4"
    }
}
