# Copy to .env and adjust. DATABASE_URL is the only setting that has to be set.
# Host, port and credentials of the core database; the host may be another machine.
# Replace <POSTGRES_PASSWORD> with the password you chose (special characters
# written as %-escapes); the server does not start with the placeholder.
DATABASE_URL=postgres://qbase:<POSTGRES_PASSWORD>@localhost:5433/qbase
# Interface the server listens on (0.0.0.0 = all, 127.0.0.1 = this machine only)
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Encrypts saved database passwords (at least 32 characters, e.g. `openssl rand -hex 24`;
# a shorter one stops the server unless ALLOW_SHORT_KEYS=1). Required to save
# connections, which drift checks and re-syncs use.
CONNECTION_KEY=

# Two-factor sign-in with an authenticator app (Google Authenticator, Microsoft
# Authenticator, Authy, 1Password ...). Optional: off for everyone until a person
# turns it on, and it works with no internet.
# SECRETS_KEY encrypts the apps' secrets (at least 32 characters); unset = the
# CONNECTION_KEY is used, and with neither it is simply not offered. Do not lose it.
SECRETS_KEY=
# 1 keeps a CONNECTION_KEY or SECRETS_KEY of 16 to 31 characters working (warned about at start)
# ALLOW_SHORT_KEYS=

# The first account (the administrator) needs a setup token. Unset = the server makes one
# at start and prints it once; set it (16 or more characters) to choose it yourself, which
# you need with several copies of the server behind one address.
# SETUP_TOKEN=
# false removes the feature completely: no endpoints, no screens
MFA_ENABLED=true
# 30-second steps a code is accepted either side of now (0 to 5, default 1).
# The server's clock must be right (NTP)
MFA_WINDOW_STEPS=1

# Opening a diagram checks its database for drift. A report this many seconds
# old (or less) is reused while the diagram and its settings are unchanged, so
# opening it again does not read the database again. 0 always reads it.
DRIFT_CACHE_SECONDS=300

# Hosts the server may connect to even though they are private, comma separated.
# Hostnames, IPs or IPv4 CIDRs, e.g. db.internal,10.0.0.0/8
INTROSPECT_ALLOW_HOSTS=

# The same, for drift webhooks only (private webhook targets are blocked by default).
WEBHOOK_ALLOW_HOSTS=

SHARE_RATE_LIMIT=60

# Calls a minute per user: schema lint (it runs synchronously), and connections
# to customers' databases (introspection, drift checks)
LINT_RATE_LIMIT=30
OUTBOUND_RATE_LIMIT=20

SESSION_DAYS=30
# A session nobody used for this many days ends early (0 = only SESSION_DAYS applies)
SESSION_IDLE_DAYS=14

# The session cookie's Secure flag: true, false, or auto (only on requests that
# arrived over HTTPS). Behind a TLS-terminating proxy set TRUST_PROXY too, so
# the proxy's X-Forwarded-Proto is believed. Use true once everything is HTTPS
COOKIE_SECURE=auto

# Sign-in, sign-up and change-password calls a minute per client address, and
# how many failed sign-ins (or wrong current passwords) an account may have
# before it is locked for AUTH_LOCKOUT_MINUTES
AUTH_RATE_LIMIT=20
AUTH_MAX_FAILURES=10
AUTH_LOCKOUT_MINUTES=15

# Fewest characters of a new password (default 12, never below 8). A new
# password also needs a capital letter, a number and a symbol. These rules apply
# when a password is set, never at sign-in, so existing passwords keep working
PASSWORD_MIN_LENGTH=12

# Largest request body on ordinary routes (KB), and on the routes that carry a
# whole diagram (MB)
BODY_LIMIT_KB=1024
DIAGRAM_BODY_LIMIT_MB=50

# Newest snapshots kept per diagram; older ones are deleted (0 keeps them all)
SNAPSHOT_KEEP=200

# Newest drift reports kept per diagram; older ones are deleted (0 keeps them all)
DRIFT_REPORT_KEEP=50

# While auto-publish is on, a save rewrites the person's latest auto snapshot if it is
# younger than this many seconds, instead of adding another copy (0 adds one every save)
AUTO_PUBLISH_COALESCE_SECONDS=300

# Share links revoked or expired this many days ago are deleted (0 keeps them all)
DEAD_LINK_KEEP_DAYS=30

# Audit rows older than this many days are deleted (0 keeps them all)
AUDIT_RETENTION_DAYS=365

# A save is logged at most once per person and diagram in this many minutes (0 logs every save)
AUDIT_SAVE_MINUTES=60

# Most live viewers one share link may have open at once
SSE_MAX_PER_LINK=100
# Most live viewers one client address may have open at once, over all links
SSE_MAX_PER_IP=20
# Seconds between pings on a live stream; each one re-checks a signed-in viewer's session
SSE_HEARTBEAT_SECONDS=25

# Set when running behind a reverse proxy so rate limits see each visitor's own
# address: the number of proxies in front of the server (1 for a single
# reverse proxy), or comma separated proxy addresses. `true` is refused: it would
# believe an X-Forwarded-For header that any visitor can send.
TRUST_PROXY=

# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# Most database connections the server opens at once. Each replica also holds one
# more for live updates, and Postgres' max_connections must cover
# replicas x (DB_POOL_MAX + 1); see README, "Scaling".
DB_POOL_MAX=10

# Seconds a database statement may run before it is cancelled; 0 for no limit.
# Migrations at start-up are not limited.
DB_STATEMENT_TIMEOUT_SECONDS=120
