# Copy to .env and adjust. Nothing here is required for local development.
# Host, port and credentials of the core database; the host may be another machine
DATABASE_URL=postgres://qubdidb:qubdidb@localhost:5433/qubdidb
# Interface the server listens on (0.0.0.0 = all, 127.0.0.1 = this machine only)
HOST=0.0.0.0
PORT=3001
SESSION_SECRET=change-me
CORS_ORIGIN=http://localhost:5173

# Encrypts saved database passwords (at least 16 characters). Required to save
# connections, which drift checks and re-syncs use.
CONNECTION_KEY=

# Opening a diagram checks its database for drift. A report this many seconds
# old (or less) is reused while the diagram and its settings are unchanged, so
# opening it again does not read the database again. 0 always reads it.
DRIFT_CACHE_SECONDS=300

# Hosts the server may connect to even though they are private, comma separated.
# Hostnames, IPs or IPv4 CIDRs, e.g. db.internal,10.0.0.0/8
INTROSPECT_ALLOW_HOSTS=

SHARE_RATE_LIMIT=60

# Calls a minute per user: schema lint (it runs synchronously), and connections
# to customers' databases (introspection, drift checks)
LINT_RATE_LIMIT=30
OUTBOUND_RATE_LIMIT=20

SESSION_DAYS=30

# Sign-in, sign-up and change-password calls a minute per client address, and
# how many failed sign-ins (or wrong current passwords) an account may have
# before it is locked for AUTH_LOCKOUT_MINUTES
AUTH_RATE_LIMIT=20
AUTH_MAX_FAILURES=10
AUTH_LOCKOUT_MINUTES=15

# Largest request body on ordinary routes (KB), and on the routes that carry a
# whole diagram (MB)
BODY_LIMIT_KB=1024
DIAGRAM_BODY_LIMIT_MB=50

# Newest snapshots kept per diagram; older ones are deleted (0 keeps them all)
SNAPSHOT_KEEP=200

# Newest drift reports kept per diagram; older ones are deleted (0 keeps them all)
DRIFT_REPORT_KEEP=50

# Share links revoked or expired this many days ago are deleted (0 keeps them all)
DEAD_LINK_KEEP_DAYS=30

# Audit rows older than this many days are deleted (0 keeps them all)
AUDIT_RETENTION_DAYS=365

# Most live viewers one share link may have open at once
SSE_MAX_PER_LINK=100

# Set when running behind a reverse proxy so rate limits see each visitor's own
# address: true, a number of proxy hops, or comma separated proxy addresses
TRUST_PROXY=

# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# Most database connections the server opens at once
DB_POOL_MAX=10
