{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node"],
        "resolveJsonModule": true,
        "paths": { "@/*": ["../src/*"] }
    },
    "include": ["src", "test", "scripts", "drizzle.config.ts", "vitest.config.ts"]
}
